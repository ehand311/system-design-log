---
import type { CollectionEntry } from 'astro:content';
import { tagSlug } from '../lib/tags';

interface Props {
  problem: CollectionEntry<'problems'>;
  /** Display position, already zero-padded. Omit to hide the numeral. */
  num?: string;
}

const { problem, num } = Astro.props;

const date = problem.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

const cardMeta = [
  problem.data.problemType,
  problem.data.constraint,
].filter(Boolean);
---

<li class="card reveal">
  {num && <span class="card__num" aria-hidden="true">{num}</span>}

  {
    cardMeta.length > 0 && (
      <p class="card__kicker">
        {cardMeta.map((item, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            <span>{item}</span>
          </>
        ))}
      </p>
    )
  }

  <h3 class="card__title">
    {/* Stretched link: the ::after covers the whole card, so the entire card is
        clickable while the accessible link text stays just the title. */}
    <a class="card__link" href={`/problems/${problem.id}/`}>{problem.data.title}</a>
    {problem.data.draft && <span class="badge badge--draft">Draft</span>}
  </h3>

  <p class="card__summary">{problem.data.summary}</p>

  {
    problem.data.lesson && (
      <p class="card__lesson">
        <span>Lesson</span>
        {problem.data.lesson}
      </p>
    )
  }

  <div class="card__foot">
    <time class="card__date" datetime={problem.data.date.toISOString()}>{date}</time>
    {
      problem.data.tags.length > 0 && (
        <span class="tag-row">
          {problem.data.tags.map((tag) => (
            <a class="tag" href={`/tags/${tagSlug(tag)}/`}>
              {tag}
            </a>
          ))}
        </span>
      )
    }
  </div>
</li>
