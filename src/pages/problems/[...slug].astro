---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { tagSlug, readingMinutes } from '../../lib/tags';
import { getProblems } from '../../lib/content';

export async function getStaticPaths() {
  const problems = (await getProblems()).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );

  return problems.map((problem, i) => ({
    params: { slug: problem.id },
    props: {
      problem,
      // Newest-first order, so "newer" is the previous index.
      newer: problems[i - 1] ?? null,
      older: problems[i + 1] ?? null,
    },
  }));
}

interface Props {
  problem: CollectionEntry<'problems'>;
  newer: CollectionEntry<'problems'> | null;
  older: CollectionEntry<'problems'> | null;
}

const { problem, newer, older } = Astro.props;
const { Content, headings } = await render(problem);

// Frontmatter dates parse as UTC midnight; format in UTC so they don't shift a day back.
const formattedDate = problem.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const minutes = readingMinutes(problem.body ?? '');
const source = problem.data.source;
---

<BaseLayout title={`${problem.data.title} — Eric Handal`} description={problem.data.summary}>
  <TableOfContents headings={headings} />

  <a class="back-link" href="/">&larr; All problems</a>

  <p class="post-meta">
    <span>{formattedDate}</span>
    <span>{minutes} min read</span>
    {problem.data.draft && <span class="badge badge--draft">Draft — not published</span>}
    {source && <span class="badge">Study notes</span>}
    {
      problem.data.tags.map((tag) => (
        <a class="tag" href={`/tags/${tagSlug(tag)}/`}>
          {tag}
        </a>
      ))
    }
  </p>

  <h1>{problem.data.title}</h1>
  <p class="lede">{problem.data.summary}</p>

  {
    source && (
      <p class="source-note">
        Worked through <a href={source.url}>{source.label}</a>. The framing is theirs; the notes and
        any errors are mine.
      </p>
    )
  }

  <article class="prose">
    <Content />
  </article>

  {/* A single published problem has no siblings — skip the empty bordered row. */}
  {
    (newer || older) && (
      <nav class="post-nav" aria-label="More problems">
        {older ? (
          <a class="post-nav__link" href={`/problems/${older.id}/`} rel="prev">
            <span class="post-nav__dir">Older</span>
            <span class="post-nav__title">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {newer ? (
          <a class="post-nav__link post-nav__link--next" href={`/problems/${newer.id}/`} rel="next">
            <span class="post-nav__dir">Newer</span>
            <span class="post-nav__title">{newer.data.title}</span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }

  <p class="post-nav__all"><a href="/">See all problems</a></p>
</BaseLayout>
